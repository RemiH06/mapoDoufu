<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-2xl mx-auto text-center py-16">
    <img src={~p"/images/mapo-logo.svg"} width="80" class="mx-auto mb-6" />

    <h1 class="text-4xl font-mono font-bold tracking-tight">Mapo</h1>
    <p class="mt-2 text-base-content/70">Mapo, powered by Gaiarda</p>

    <p class="mt-8 text-lg leading-relaxed">
      Gaiarda contesta <strong>qué hay</strong>. Mapo contesta
      <strong>qué deberías hacer con eso</strong>.
    </p>

    <div class="mt-10 flex justify-center gap-4">
      <%= if @current_scope do %>
        <.link href={~p"/teams"} class="btn btn-primary">
          Ir a mis equipos
        </.link>
      <% else %>
        <.link href={~p"/users/register"} class="btn btn-primary">
          Crear cuenta
        </.link>
        <.link href={~p"/users/log-in"} class="btn btn-soft">
          Iniciar sesión
        </.link>
      <% end %>
    </div>
  </div>
</Layouts.app>
