<%!-- Portada: la mesa se arma. El plano real de Guadalajara y, encima, los
     acetatos que se deslizan uno tras otro (censo, DENUE, isócrona) hasta la
     marca del equipo. Sin JavaScript, o con movimiento reducido, la mesa ya
     está armada. La animación vive en assets/js/portada.js. --%>
<div class="esquina portada-esquina">
  <button id="modo" type="button" class="modo" data-modo>Modo</button>
  <%= if @current_scope do %>
    <.link href={~p"/users/settings"} class="esquina-enlace">Cuenta</.link>
    <.link href={~p"/users/log-out"} method="delete" class="esquina-enlace">Salir</.link>
  <% else %>
    <.link href={~p"/users/log-in"} class="esquina-enlace">Entrar</.link>
  <% end %>
</div>

<main id="portada" class="portada">
  <section class="lamina pegado" aria-labelledby="t-portada">
    <div class="lamina-titulo">
      <img src={~p"/images/mapo-logo.svg"} alt="" />
      <h1 id="t-portada">MAPO</h1>
    </div>
    
    <p class="lamina-lema">
      Los datos abiertos de México <b>sobre la mesa</b>, para que <b>tu equipo decida</b> dónde.
    </p>
    
    <div class="lamina-acciones">
      <%= if @current_scope do %>
        <.link href={~p"/mapa"} class="boton primario">Abrir el mapa</.link>
        <.link href={~p"/teams"} class="boton">Mis equipos</.link>
      <% else %>
        <.link href={~p"/users/register"} class="boton primario">Crear cuenta</.link>
        <.link href={~p"/users/log-in"} class="boton">Entrar</.link>
      <% end %>
    </div>
    
    <dl>
      <dt>Lámina</dt>
      
      <dd>0 · portada</dd>
      
      <dt>Plano</dt>
      
      <dd>Guadalajara, 442 AGEB</dd>
      
      <dt>Fuentes</dt>
      
      <dd>INEGI, SESNSP, OpenStreetMap</dd>
      
      <dt>Datos</dt>
      
      <dd><.link href={~p"/privacidad"}>Aviso de privacidad</.link></dd>
      
      <%= if @current_scope do %>
        <dt>Cuenta</dt>
        
        <dd>{@current_scope.user.email}</dd>
      <% end %>
    </dl>
  </section>
  
  <figure class="mesa-portada" aria-labelledby="rotulo-pregunta">
    {plano_portada(assigns)}
    <figcaption id="rotulo" class="rotulo-portada pegado" aria-live="polite">
      <span id="rotulo-tipo" class="doc-tipo">Cuatro acetatos sobre el plano</span>
      <span id="rotulo-pregunta" class="rotulo-pregunta">
        ¿Dónde abrir una papelería en el centro de Guadalajara?
      </span>
      
      <span id="rotulo-dato" class="rotulo-dato">
        Población del censo 2020, negocios de DENUE, 10 minutos por carretera y la marca del equipo.
      </span>
    </figcaption>
     <%!-- La charola solo sirve con JavaScript: el script le quita el hidden. --%>
    <nav id="charola-portada" class="charola-portada" aria-label="Acetatos de la portada" hidden>
      <button
        :for={
          {clave, piel, nombre} <- [
            {"censo", "demografia", "Población"},
            {"denue", "comercio", "Papelerías"},
            {"isocrona", "movilidad", "10 minutos"},
            {"marca", "urbanismo", "Tus marcas"}
          ]
        }
        type="button"
        class="pestana-portada"
        data-acetato={clave}
        data-piel={piel}
        aria-pressed="true"
      >
        {nombre}
      </button>
    </nav>
  </figure>
</main>
 <Layouts.flash_group flash={@flash} />
