<!DOCTYPE html>
<html lang="es" data-piel="urbanismo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/mapo-logo.svg"} /> <.live_title
      default="Mapo"
      suffix=" · Mapo"
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>

    <script>
      // Modo claro u oscuro antes de pintar, para que no parpadee. Arranca con
      // el del sistema hasta que la persona elige uno. El botón de la esquina
      // dice a qué modo lleva, con el nombre que le da la piel activa.
      (() => {
        const MODOS = {
          urbanismo: ["Papel", "Cianotipia"], demografia: ["Cédula", "Archivo"],
          comercio: ["Libro", "Corte de caja"], consumo: ["Mostrador", "Cierre"],
          seguridad: ["Expediente", "Guardia"], laboral: ["Matutino", "Nocturno"],
          movilidad: ["Día", "Nocturna"],
        };
        const raiz = document.documentElement;
        const sistema = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const rotular = () => document.querySelectorAll("[data-modo]").forEach(b => {
          b.textContent = (MODOS[raiz.dataset.piel] || MODOS.urbanismo)[raiz.dataset.theme === "dark" ? 0 : 1];
        });
        raiz.dataset.theme = localStorage.getItem("phx:theme") || sistema();

        window.addEventListener("mapo:modo", () => {
          const nuevo = raiz.dataset.theme === "dark" ? "light" : "dark";
          localStorage.setItem("phx:theme", nuevo);
          raiz.dataset.theme = nuevo;
          window.dispatchEvent(new CustomEvent("mapo:tema", {detail: {tema: nuevo}}));
        });
        window.addEventListener("storage", e => {
          if (e.key === "phx:theme") raiz.dataset.theme = e.newValue || sistema();
        });
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
          if (!localStorage.getItem("phx:theme")) raiz.dataset.theme = sistema();
        });
        new MutationObserver(rotular).observe(raiz, {attributes: true, attributeFilter: ["data-theme", "data-piel"]});
        window.addEventListener("phx:page-loading-stop", rotular);
        document.addEventListener("DOMContentLoaded", rotular);
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    {@inner_content}
  </body>
</html>
