# Plantilla del .env de producción (docker-compose.prod.yml). Copiar a
# .env junto al compose, llenar y dejarlo con `chmod 600 .env`. El .env
# nunca se versiona. Cómo generar cada valor: docs/despliegue.md.

# Contraseña del usuario `mapo` de Postgres. Solo hexadecimal, porque va
# dentro de la URL de conexión: openssl rand -hex 32
POSTGRES_PASSWORD=

# Firma las cookies de sesión: openssl rand -base64 48
SECRET_KEY_BASE=

# Nombre con el que se entra a Mapo, sin https:// (por ejemplo
# <máquina>.<tailnet>.ts.net). Phoenix rechaza el WebSocket de otro origen.
PHX_HOST=

# Correo de quien responde por los datos; sale en /privacidad.
MAPO_CONTACTO=

# Carpeta con el mapa de México ya preprocesado para OSRM (mexico-latest.osrm.*).
MAPO_OSRM_DATOS=
