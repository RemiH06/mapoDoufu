# Plantilla del .env de producción (docker-compose.prod.yml). Copiar a
# .env junto al compose, llenar y dejarlo con `chmod 600 .env`. El .env
# nunca se versiona. Cómo generar cada valor: docs/despliegue.md.

# Contraseña del usuario `mapo` de Postgres. Solo hexadecimal, porque va
# dentro de la URL de conexión: openssl rand -hex 32
POSTGRES_PASSWORD=

# Firma las cookies de sesión: openssl rand -base64 48
SECRET_KEY_BASE=

# Nombre con el que se entra a Mapo, sin https:// (por ejemplo
# <máquina>.<tailnet>.ts.net). Phoenix rechaza el WebSocket de otro origen.
PHX_HOST=

# Puerto HTTPS con que se entra. Vacío es 443; otro si la máquina ya
# publica algo en el 443 (tailscale serve --https=<puerto>).
PHX_PORT=

# Opcional. Otros nombres con que se entra, además de PHX_HOST, con
# esquema y puerto, separados por coma (por ejemplo la tailnet:
# https://<máquina>.<tailnet>.ts.net:1865). Sin esto, LiveView no conecta
# por ellos.
PHX_ORIGENES_EXTRA=

# Correo de quien responde por los datos; sale en /privacidad.
MAPO_CONTACTO=

# Opcional. Correo real por AhaSend (docs/despliegue.md, "Correo").
# Vacíos, los correos se escriben en el log. El ID de la cuenta sale en
# la configuración de la cuenta; la llave es una "API Key v2" con alcance
# messages:send:mail.mapo.remlam.dev (empieza con aha-sk-).
MAPO_AHASEND_ACCOUNT_ID=
MAPO_AHASEND_API_KEY=

# Carpeta con el mapa de México ya preprocesado para OSRM (mexico-latest.osrm.*).
MAPO_OSRM_DATOS=
